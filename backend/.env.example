CORS_ORIGINS=*

# Chave privada da API da OpenAI, para o assistente conversacional.
# Obtenha em https://platform.openai.com/api-keys
# Sem ela o assistente continua funcionando por regras fixas, sem conversar.
OPENAI_API_KEY=

# O projeto usa GPT-5.6 Luna por padrao.
OPENAI_MODEL=gpt-5.6-luna

# Opcional: none, low, medium, high, xhigh ou max. Padrao: low.
OPENAI_REASONING_EFFORT=low
